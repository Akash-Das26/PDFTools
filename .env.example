# Copy this file to .env for local development.
# PostgreSQL is required by the API server for job history and statistics.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pdftools

# Optional: enables the three model-backed AI tools (summarizer, translate,
# chat). Without it the API works and these tools answer 503.
OPENAI_API_KEY=

# Optional: point the AI client at any OpenAI-protocol-compatible provider and
# choose its model. Example — Google Gemini's OpenAI-compatible endpoint:
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OPENAI_MODEL=gemini-3.5-flash-lite
# Unset, the client uses OpenAI's default endpoint with gpt-5-mini (a key
# starting with sk-or- is treated as OpenRouter automatically).
OPENAI_BASE_URL=
OPENAI_MODEL=

# Optional port overrides.
WEB_PORT=5173
API_PORT=8080

# Optional rate limiting (Open Item 18). Defaults: 300 req / 15 min for /api,
# 30 req / 15 min for /pdf uploads. Set RATE_LIMIT_DISABLED=1 to skip both
# (the verification harness sets this itself; leave it unset in production).
# RATE_LIMIT_DISABLED=1
# RATE_LIMIT_WINDOW_MINUTES=15
# RATE_LIMIT_API_MAX=300
# RATE_LIMIT_UPLOAD_MAX=30
# Set to 1 when behind exactly one trusted reverse proxy so req.ip is the
# client's address (X-Forwarded-For) instead of the proxy's.
# RATE_LIMIT_TRUST_PROXY=1

# Optional CORS allow-list, comma-separated exact origins. Unset: dev defaults
# (Vite on :5173/:5174 + loopback) in development, refusal of cross-origin
# browser calls in production. Use * to restore allow-all (not recommended).
# CORS_ORIGINS=https://pdftools.example.org,https://www.pdftools.example.org