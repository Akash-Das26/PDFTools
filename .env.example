# Copy this file to .env for local development.
# PostgreSQL is required by the API server for job history and statistics.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pdftools

# Optional: enables the three model-backed AI tools (summarizer, translate,
# chat). Without it the API works and these tools answer 503.
OPENAI_API_KEY=

# Optional: point the AI client at any OpenAI-protocol-compatible provider and
# choose its model. Example — Google Gemini's OpenAI-compatible endpoint:
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OPENAI_MODEL=gemini-3.5-flash-lite
# Unset, the client uses OpenAI's default endpoint with gpt-5-mini (a key
# starting with sk-or- is treated as OpenRouter automatically).
OPENAI_BASE_URL=
OPENAI_MODEL=

# Optional port overrides.
WEB_PORT=5173
API_PORT=8080