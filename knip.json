{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "drizzle": {
    "config": []
  },
  "workspaces": {
    "lib/db": {
      "entry": ["drizzle.config.ts"]
    },
    "artifacts/api-server": {
      "entry": [
        "src/index.ts",
        "src/services/pdf/parse-worker-child.ts"
      ]
    },
    "artifacts/pdftools": {
      "ignore": [
        "src/components/ui/**"
      ]
    },
    "scripts": {
      "entry": [
        "verify-ui/**/*.mjs",
        "src/**/*.ts"
      ],
      "ignoreDependencies": [
        "@cantoo/pdf-lib"
      ],
      "ignoreBinaries": [
        "openssl"
      ]
    }
  }
}
